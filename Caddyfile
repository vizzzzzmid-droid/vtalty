# Caddy reverse proxy for vitality.
# CADDY_DOMAIN=localhost  -> local HTTPS with Caddy internal CA (dev/smoke).
# CADDY_DOMAIN=vitality.kirskiy.shop -> automatic public ACME certificates.
# Requires ports 80+443 reachable from the internet for issuance.
{
	auto_https ignore_loaded_certs
}

{$CADDY_DOMAIN:localhost} {
	encode gzip

	# Access logs: Cookie/Authorization headers are REDACTED by Caddy's
	# default. The single-use WS `ticket` and LiveKit `access_token` query
	# params are scrubbed below so join tokens never land in logs
	# (verified against Caddy log directive docs + livekit-client source,
	# which sends access_token as an /rtc query param).
	log {
		format filter {
			request>uri query {
				replace ticket REDACTED
				replace access_token REDACTED
			}
		}
	}

	# Liveness/readiness are served by the API (used by compose-smoke).
	handle /healthz {
		reverse_proxy server:3000
	}

	handle /readyz {
		reverse_proxy server:3000
	}

	handle /api/* {
		reverse_proxy server:3000
	}

	handle /ws* {
		reverse_proxy server:3000
	}

	# Strip the prefix: LiveKit SDK speaks at /rtc, /twirp, ... on :7880.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy web:80
	}
}
