# Copy to .env before first run:  cp .env.example .env
# Never commit real secrets. All values below are dev-only placeholders.

# Postgres
POSTGRES_USER=vitality
POSTGRES_PASSWORD=dev-only-password-change-me
POSTGRES_DB=vitality

# Server
PORT=3000
HOST=0.0.0.0
JWT_ACCESS_SECRET=dev-access-secret-please-change-me-32plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
REGISTRATION_MODE=invite-only

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-secret-please-change-me-32plus
LIVEKIT_URL=http://livekit:7880
# Public signaling URL handed to web clients (must match the Caddy route).
# Localhost dev: wss://localhost/livekit ; prod: wss://vitality.kirskiy.shop/livekit
LIVEKIT_PUBLIC_URL=wss://localhost/livekit
VOICE_MAX_PARTICIPANTS=15
VOICE_RECONCILE_INTERVAL_SECONDS=60

# Uploads (local driver, Phase 1: directory only, no routes yet)
STORAGE_DRIVER=local
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760

# Caddy: production domain once DNS points at the VPS (Phase 1 dev: localhost)
CADDY_DOMAIN=localhost
PUBLIC_APP_URL=https://localhost
