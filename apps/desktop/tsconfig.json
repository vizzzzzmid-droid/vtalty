{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
  },
  "include": ["src"],
  // The connect-page renderer is a browser ESM bundle built separately
  // (tsconfig.renderer.json); compiling it here would emit CJS that the
  // <script> tag cannot execute.
  "exclude": ["src/renderer"]
}
