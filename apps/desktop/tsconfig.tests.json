{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Typecheck-only: the Playwright spec (.mts) uses import.meta and runs
    // through Playwright's transform, never tsc emit.
    "module": "node16",
    "moduleResolution": "node16"
  },
  "include": ["src", "tests", "scripts"]
}
