{
  "name": "@vitality/server",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/websocket": "11.0.0",
    "@vitality/shared": "workspace:*",
    "argon2": "0.45.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "jsonwebtoken": "9.0.0",
    "pino": "^10.0.0",
    "postgres": "^3.4.0",
    "ws": "8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "8.18.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
