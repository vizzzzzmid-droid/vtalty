{
  "name": "vitality",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @vitality/shared build && pnpm --filter @vitality/server build && pnpm --filter @vitality/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @vitality/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @vitality/shared build && pnpm -r test",
    "test:scripts": "node --test scripts/init.test.mjs",
    "init": "node scripts/init.mjs",
    "doctor": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@livekit/rtc-node": "1.1.0",
    "ws": "8.21.3"
  }
}
